{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/weekly",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/canteens/notify?kind=reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/canteens/notify?kind=summary",
      "schedule": "30 5 * * *"
    }
  ],
  "regions": [
    "fra1"
  ]
}
