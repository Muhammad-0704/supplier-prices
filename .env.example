# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Секретный ключ: только на сервере, никогда не с префиксом NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- 1С:Фреш, стандартный интерфейс OData ---
# mock — демо-данные без 1С (удобно для первого запуска), odata — настоящая база
ONEC_MODE=mock
# Адрес вида https://1cfresh.com/a/sbm/1234567/odata/standard.odata
ONEC_ODATA_URL=
# Служебный пользователь, созданный в приложении 1С:Фреш для OData
ONEC_USER=
ONEC_PASSWORD=
# Сколько дней истории забрать при первой синхронизации
SYNC_DAYS_BACK=180

# --- Расписание ---
# Любая длинная случайная строка. Vercel Cron и Supabase pg_cron передают её в заголовке Authorization
CRON_SECRET=

# Через сколько дней без закупок товар считается редким
NEXT_PUBLIC_RARE_DAYS=30

# --- iiko (серверы точек, iikoServer API) ---
# Один пользователь с одинаковым логином и паролем на всех серверах, только просмотр отчётов
IIKO_LOGIN=
IIKO_PASSWORD=
